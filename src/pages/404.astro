---
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout title="404 | Page Not Found">
  <div class="min-h-[60vh] flex flex-col items-center justify-center text-center">
    <h1 class="text-9xl font-bold tracking-tighter mb-4 opacity-10">404</h1>
    <h2 class="text-3xl font-bold mb-6">Lost in the Matrix?</h2>
    <p class="text-gray-600 dark:text-gray-400 mb-8 max-w-md">
      The page you're looking for doesn't exist or has been moved to another dimension.
    </p>
    <a
      href="/"
      class="inline-flex items-center gap-2 px-6 py-3 bg-foreground text-background font-semibold rounded-full hover:opacity-90 transition-opacity"
    >
      Return to Home
    </a>
  </div>
</BaseLayout>
