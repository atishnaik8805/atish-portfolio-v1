---
import { formatDate } from '@/utils/date';
import { calculateReadingTime } from '@/utils/readingTime';

interface Props {
  post: {
    slug: string;
    body: string;
    data: {
      title: string;
      description: string;
      publishDate: Date;
      tags: string[];
      externalUrl?: string;
      platform?: 'Medium' | 'LinkedIn' | 'Dev.to';
    }
  };
}

const { post } = Astro.props;
const { title, description, publishDate, tags, externalUrl, platform } = post.data;
const readingTime = calculateReadingTime(post.body);
---

<article class="p-6 rounded-2xl border border-gray-200 dark:border-gray-800 hover:bg-gray-50 dark:hover:bg-gray-900 transition-colors">
  <div class="flex justify-between items-baseline mb-2">
    <span class="text-xs font-medium text-gray-500 uppercase tracking-wider">
      {formatDate(publishDate)} • {readingTime}
    </span>
    {platform && (
      <span class="text-xs font-bold text-primary px-2 py-0.5 rounded bg-primary/10">
        {platform}
      </span>
    )}
  </div>
  
  <h3 class="text-xl font-bold mb-2 group">
    {externalUrl ? (
      <a href={externalUrl} target="_blank" rel="noopener noreferrer" class="hover:underline flex items-center gap-2">
        {title}
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="opacity-0 group-hover:opacity-100 transition-opacity"><path d="M7 7h10v10"/><path d="M7 17 17 7"/></svg>
      </a>
    ) : (
      <a href={`/blog/${post.slug}`} class="hover:underline">
        {title}
      </a>
    )}
  </h3>
  
  <p class="text-gray-600 dark:text-gray-400 mb-4 line-clamp-2">
    {description}
  </p>
  
  <div class="flex flex-wrap gap-2">
    {tags.map((tag) => (
      <span class="text-xs text-gray-500">#{tag}</span>
    ))}
  </div>
</article>
