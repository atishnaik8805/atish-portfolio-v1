---
import { formatDate, formatDuration } from '@/utils/date';

interface Props {
  experience: {
    data: {
      title: string;
      company: string;
      location?: string;
      startDate: Date;
      endDate: Date | string;
      achievements: string[];
      skills?: string[];
    }
  };
}

const { experience } = Astro.props;
const { title, company, location, startDate, endDate, achievements, skills } = experience.data;
---

<div class="relative pl-8 pb-12 border-l border-gray-200 dark:border-gray-800 last:pb-0">
  <div class="absolute -left-1.5 top-1.5 w-3 h-3 rounded-full bg-gray-300 dark:bg-gray-700"></div>
  
  <div class="flex flex-col md:flex-row md:justify-between md:items-baseline gap-1">
    <h3 class="text-xl font-bold">{title}</h3>
    <span class="text-sm font-medium text-gray-500 dark:text-gray-400">
      {formatDate(startDate)} — {typeof endDate === 'string' ? endDate : formatDate(endDate)}
      <span class="ml-2 px-2 py-0.5 rounded-full bg-gray-100 dark:bg-gray-800 text-gray-700 dark:text-gray-300">
        {formatDuration(startDate, endDate)}
      </span>
    </span>
  </div>
  
  <p class="mt-1 text-lg font-medium text-gray-700 dark:text-gray-300">
    {company}{location ? ` • ${location}` : ''}
  </p>
  
  <ul class="mt-4 space-y-2">
    {achievements.map((achievement) => (
      <li class="text-gray-600 dark:text-gray-400 flex gap-2">
        <span class="text-gray-400">•</span>
        {achievement}
      </li>
    ))}
  </ul>

  {skills && (
    <div class="mt-4 flex flex-wrap gap-2">
      {skills.map((skill) => (
        <span class="px-2 py-1 text-xs font-medium rounded-md bg-gray-100 dark:bg-gray-800 text-gray-600 dark:text-gray-400">
          {skill}
        </span>
      ))}
    </div>
  )}
</div>
