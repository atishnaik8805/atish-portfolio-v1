---
import { FileText } from 'lucide-react';
import SocialLinks from '@/components/UI/SocialLinks.astro';

const currentYear = new Date().getFullYear();
const prevYearShort = (currentYear - 1).toString().slice(-2);
const currentYearShort = currentYear.toString().slice(-2);
const resumeFilename = `Atish Naik Resume-${prevYearShort}-${currentYearShort}`;
---

<section class="py-16 md:py-24">
  <div class="flex flex-col-reverse md:flex-row gap-12 items-center md:items-start justify-between">
    <div class="max-w-2xl">
      <h1 class="text-4xl md:text-6xl font-bold tracking-tight">
        Atish Naik
      </h1>
      <h2 class="mt-4 text-xl md:text-2xl text-gray-600 dark:text-gray-400 font-medium">
        Full Stack Software Developer specializing in UI/UX and front-end architecture for B2B Web Applications.
      </h2>
      <p class="mt-6 text-lg leading-8 text-gray-700 dark:text-gray-300">
        I have proven experience in designing, developing, and maintaining high-performance enterprise solutions. 
        Currently leading efforts in streamlining data conversion and workflow automation through LLM-powered solutions and driving AI adoption across digital verticals.
      </p>
      
      <div class="mt-10 flex flex-wrap gap-6 items-center">
        <SocialLinks />
        <a
          href="/Atish-Naik-Resume.pdf"
          target="_blank"
          download={resumeFilename}
          class="inline-flex items-center gap-2 px-6 py-3 bg-foreground text-background font-semibold rounded-full hover:opacity-90 transition-opacity"
        >
          <FileText size={20} />
          Download Resume
        </a>
      </div>
    </div>

    <div class="relative group">
      <div class="absolute -inset-1 bg-gradient-to-r from-primary to-blue-600 rounded-2xl blur opacity-25 group-hover:opacity-50 transition duration-1000 group-hover:duration-200"></div>
      <img
        src="/images/portfolio-v1.jpg"
        alt="Atish Naik"
        class="relative w-48 h-48 md:w-64 md:h-64 rounded-2xl object-cover shadow-2xl border-4 border-white dark:border-gray-800 -rotate-3 hover:rotate-0 transition-transform duration-500"
      />
    </div>
  </div>
</section>
